{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One line of responses.jsonl (one student)",
  "type": "object",
  "required": [
    "id",
    "name",
    "email",
    "timestamp",
    "answers"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^S[0-9]{2,}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "pattern": "@example\\.edu$"
    },
    "timestamp": {
      "type": "string"
    },
    "answers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^q[0-9]+$"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
