{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "labels.json",
  "type": "object",
  "required": [
    "scenario",
    "default",
    "participants",
    "relations"
  ],
  "additionalProperties": false,
  "properties": {
    "scenario": {
      "type": "string"
    },
    "default": {
      "type": "object",
      "required": [
        "relation",
        "ground_truth"
      ],
      "additionalProperties": false,
      "properties": {
        "relation": {
          "enum": [
            "verbatim_copy",
            "light_edit_copy",
            "partial_overlap",
            "paraphrase",
            "reordered_words",
            "shared_template_sentence",
            "ai_near_verbatim",
            "ai_paraphrase",
            "shared_ai_source",
            "mcq_copy",
            "mcq_shared_source",
            "code_renamed",
            "code_reformatted",
            "code_reordered",
            "decoy_function_words",
            "shared_text_source",
            "independent"
          ]
        },
        "ground_truth": {
          "enum": [
            "copied",
            "partial",
            "shared_source",
            "not_copied"
          ]
        }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "source_name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2,}$"
          },
          "role": {
            "enum": [
              "student",
              "ai_reference"
            ]
          },
          "source_name": {
            "type": "string"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relation",
          "ground_truth"
        ],
        "additionalProperties": false,
        "properties": {
          "members": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "pattern": "^S[0-9]{2,}$"
            }
          },
          "between": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^S[0-9]{2,}$"
              }
            }
          },
          "relation": {
            "enum": [
              "verbatim_copy",
              "light_edit_copy",
              "partial_overlap",
              "paraphrase",
              "reordered_words",
              "shared_template_sentence",
              "ai_near_verbatim",
              "ai_paraphrase",
              "shared_ai_source",
              "mcq_copy",
              "mcq_shared_source",
              "code_renamed",
              "code_reformatted",
              "code_reordered",
              "decoy_function_words",
              "shared_text_source",
              "independent"
            ]
          },
          "ground_truth": {
            "enum": [
              "copied",
              "partial",
              "shared_source",
              "not_copied"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^S[0-9]{2,}$"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^q[0-9]+$"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "oneOf": [
          {
            "required": [
              "members"
            ]
          },
          {
            "required": [
              "between"
            ]
          }
        ]
      }
    }
  }
}
